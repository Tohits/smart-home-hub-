# Express Server Port
PORT=5000
NODE_ENV=production

# HiveMQ Cloud MQTT Broker Settings
MQTT_HOST=93bad3def29641e399de9a7b9c676613.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=tohits
MQTT_PASS=YOUR_HIVEMQ_PASSWORD_HERE

# Security & Session Secrets
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET_HERE
OTA_SECRET_KEY=YOUR_SECURE_OTA_HMAC_SECRET_HERE

# Location & Solar Schedule Configuration (Asia/Kolkata IST)
TIMEZONE=Asia/Kolkata
LATITUDE=28.6139
LONGITUDE=77.2090

# Web Push VAPID Keys (Generate with npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE

# PostgreSQL Database URL (Optional: For Render Managed PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/smarthomedb
