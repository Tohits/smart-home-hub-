{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://smart-home-backend-16eu.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://smart-home-backend-16eu.onrender.com/socket.io/$1"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
